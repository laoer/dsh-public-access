{
  "name": "dsh-public-access",
  "version": "1.1.2",
  "description": "DeepSeek Harness reverse proxy plugin - bind to 0.0.0.0, support public IP and nginx access, with login authentication",
  "type": "module",
  "main": "src/reverse-proxy-fix.js",
  "exports": {
    ".": "./src/reverse-proxy-fix.js",
    "./web-startup": "./src/web-startup.js"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "start.sh",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "reverse-proxy",
    "nginx",
    "auth"
  ],
  "author": "JNan-QQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/jn-qq/dsh-reverse-proxy.git"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
