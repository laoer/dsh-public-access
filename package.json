{
  "name": "@timgong/dsh-public-access",
  "version": "2.2.0-beta.2",
  "description": "DeepSeek Harness plugin - public/LAN access (0.0.0.0 + trusted hosts) with password auth, scrypt credential store and settings-panel password change, compatible with dsh 0.2.1-rc.2 (laoer fork)",
  "type": "module",
  "main": "src/reverse-proxy-fix.js",
  "exports": {
    ".": "./src/reverse-proxy-fix.js",
    "./web-startup": "./src/web-startup.js",
    "./client": "./src/client/index.js"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "start.sh",
    "README.en.md",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "reverse-proxy",
    "nginx",
    "auth",
    "public-access",
    "web-ui",
    "authentication",
    "proxy",
    "remote-access"
  ],
  "author": "Tim Gong <tianyisoft@gmail.com>",
  "contributors": [
    {
      "name": "JNan-QQ",
      "url": "https://github.com/JNan-QQ"
    }
  ],
  "license": "MulanPSL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoer/dsh-public-access.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "check": "npm run typecheck && npm test",
    "verify:artifacts": "npm run build && git diff --exit-code -- src",
    "prepublishOnly": "npm run verify:artifacts && npm test",
    "start": "./start.sh"
  },
  "homepage": "https://github.com/laoer/dsh-public-access",
  "bugs": {
    "url": "https://github.com/laoer/dsh-public-access/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
