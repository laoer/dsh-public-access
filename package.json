{
  "name": "dsh-public-access",
  "version": "2.1.1",
  "description": "DeepSeek Harness plugin - public/LAN access (0.0.0.0 + trusted hosts) with login auth, compatible with dsh 0.2.1-rc.2",
  "type": "module",
  "main": "src/reverse-proxy-fix.js",
  "exports": {
    ".": "./src/reverse-proxy-fix.js",
    "./web-startup": "./src/web-startup.js"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "start.sh",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "reverse-proxy",
    "nginx",
    "auth",
    "public-access",
    "web-ui",
    "authentication",
    "proxy",
    "remote-access"
  ],
  "author": "JNan-QQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JNan-QQ/dsh-public-access.git"
  },
  "scripts": {
    "start": "./start.sh",
    "test": "node --test test/*.test.js"
  },
  "homepage": "https://github.com/JNan-QQ/dsh-public-access",
  "bugs": {
    "url": "https://github.com/JNan-QQ/dsh-public-access/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
